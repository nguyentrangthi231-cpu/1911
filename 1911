<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🎉 Chúc Mừng Ngày Quốc Tế Nam Giới 🎉</title>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
<style>
body { margin:0; font-family:'Roboto', sans-serif; background:linear-gradient(to right,#1e3c72,#2a5298); color:#fff; text-align:center; }
h1 { font-size:2.5em; margin-top:40px; }
.gallery { display:flex; gap:20px; justify-content:center; flex-wrap:wrap; margin:20px auto; }
.gallery img { width:200px; border-radius:15px; transition: transform 0.3s; cursor:pointer; }
.gallery img:hover { transform: scale(1.1) rotate(2deg); }
button { background-color:#ffce00; color:#1e3c72; font-size:1.2em; padding:15px 25px; margin:20px; border:none; border-radius:10px; cursor:pointer; }
button:hover { transform:scale(1.05); }
textarea { width:80%; height:100px; border-radius:10px; padding:10px; font-size:1em; margin-top:20px; }
#displayWish { color:#00ff00; margin-top:20px; font-size:1.2em; }
#confetti { position:fixed; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:9999; }
</style>
</head>
<body>

<canvas id="confetti"></canvas>

<!-- Trang chính -->
<div id="page1">
    <h1>🎉 Chúc Mừng Ngày Quốc Tế Nam Giới 🎉</h1>
    <p>Nhấn nút bên dưới để nhận lời chúc bất ngờ 🎁</p>

    <div class="gallery">
        <img src="https://images.unsplash.com/photo-1607746882042-944635dfe10e?auto=format&fit=crop&w=500&q=80" alt="Nam giới 1">
        <img src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=500&q=80" alt="Nam giới 2">
        <img src="https://images.unsplash.com/photo-1518609878373-06d740f60d8b?auto=format&fit=crop&w=500&q=80" alt="Nam giới 3">
    </div>

    <button onclick="showPage2()">Nhận lời chúc bất ngờ 🎁</button>
</div>

<!-- Trang nhập lời chúc -->
<div id="page2" style="display:none;">
    <h1>🎁 Nhập Lời Chúc Của Bạn 🎁</h1>

    <textarea id="wishText" placeholder="Viết lời chúc ở đây..."></textarea><br>
    <button onclick="submitWish()">Gửi lời chúc</button>

    <h2 id="displayWish"></h2>
</div>

<script>
// Ẩn trang chính, hiện trang nhập lời chúc
function showPage2(){
    document.getElementById('page1').style.display='none';
    document.getElementById('page2').style.display='block';
    startConfetti();
}

// Gửi lời chúc
function submitWish(){
    const wish = document.getElementById('wishText').value.trim();
    if(wish){
        document.getElementById('displayWish').innerText = "🎉 Lời chúc của bạn: " + wish;
        document.getElementById('wishText').value = '';
        startConfetti();
    } else {
        alert("Hãy viết lời chúc trước khi gửi!");
    }
}

// Confetti
const confettiCanvas = document.getElementById('confetti');
const ctx = confettiCanvas.getContext('2d');
confettiCanvas.width = window.innerWidth;
confettiCanvas.height = window.innerHeight;

const confettiPieces = [];
for(let i=0;i<150;i++){
    confettiPieces.push({
        x:Math.random()*confettiCanvas.width,
        y:Math.random()*confettiCanvas.height - confettiCanvas.height,
        r:Math.random()*6+4,
        d:Math.random()*50,
        color:`hsl(${Math.random()*360},100%,50%)`,
        tilt:Math.random()*10-10,
        tiltAngleIncrement:Math.random()*0.07+0.05,
        tiltAngle:0
    });
}

function drawConfetti(){
    ctx.clearRect(0,0,confettiCanvas.width, confettiCanvas.height);
    confettiPieces.forEach(p=>{
        ctx.beginPath();
        ctx.lineWidth = p.r/2;
        ctx.strokeStyle = p.color;
        ctx.moveTo(p.x+p.tilt+p.r/4, p.y);
        ctx.lineTo(p.x+p.tilt, p.y+p.tilt+p.r/4);
        ctx.stroke();
    });
    updateConfetti();
}

function updateConfetti(){
    confettiPieces.forEach(p=>{
        p.tiltAngle+=p.tiltAngleIncrement;
        p.y+=(Math.cos(p.d)+3+p.r/2)/2;
        p.x+=Math.sin(p.d);
        p.tilt=Math.sin(p.tiltAngle)*15;
        if(p.y>confettiCanvas.height){ p.y=-10; p.x=Math.random()*confettiCanvas.width; }
    });
}

let confettiInterval;
function startConfetti(){
    if(confettiInterval) clearInterval(confettiInterval);
    confettiInterval=setInterval(drawConfetti,20);
    setTimeout(()=>clearInterval(confettiInterval),5000);
}
</script>

</body>
</html>
